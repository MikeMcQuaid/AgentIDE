{
  "default-configuration": "Debug",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": ".",
    },
  ],
  "files": [
    { "path": "<PROJECT>/bin", "target-membership": [ "SanductorApp/resources" ] },
    {
      "kind": "group",
      "path": ".build",
      "children": [
        { "path": "version.xcconfig" },
      ],
    }, {
      "kind": "group",
      "name": "Packages",
      "children": [
        { "path": "<PROJECT>/." },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Sanductor.app", "id": "4D649B031E07526BEA379437", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/Sanductor.app", "id": "A5FEC9402FE5EC1D2F06E2E4", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/SanductorIntentTests.xctest", "id": "E4088E9411C7B1C3F3743814", "type": "wrapper.cfbundle", "index": false },
      ],
    }, {
      "kind": "folder",
      "path": "App",
      "target-membership": [
        "SanductorApp",
      ],
      "membership-exceptions": [
        {
          "target": "SanductorApp",
          "exclusions": [
            "Assets.xcassets",
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "iOSApp",
      "target-membership": [
        "Sanductor-iOS",
      ],
      "membership-exceptions": [
        {
          "target": "Sanductor-iOS",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "group",
      "path": "Tests",
      "children": [
        { "kind": "folder", "path": "SanductorIntentTests", "target-membership": [ "SanductorIntentTests" ] },
      ],
    }, {
      "kind": "group",
      "name": "Resources",
      "children": [
        {
          "path": "App/Assets.xcassets",
          "target-membership": [
            "Sanductor-iOS/resources",
            "SanductorApp/resources",
          ],
        },
      ],
    },
  ],
  "targets": [
    {
      "name": "Sanductor-iOS",
      "id": "23F1A428A3D1A5D5A7AF5FBF",
      "product": "id:4D649B031E07526BEA379437",
      "product-type": "application",
      "legacy-provisioning-style": "automatic",
      "specialized-configurations": [
        { "name": "Debug", "file": ".build/version.xcconfig" },
        { "name": "Release", "file": ".build/version.xcconfig" },
      ],
      "build-phases": [
        "compile-sources",
        "resources",
        "frameworks",
      ],
      "package-product-members": [
        {
          "product-name": "MobileFeature",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGN_IDENTITY": "iPhone Developer",
        "CODE_SIGN_STYLE": "Automatic",
        "DEVELOPMENT_TEAM": "6248TWFRH6",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "© 2026 Mike McQuaid.",
        "INFOPLIST_KEY_NSLocalNetworkUsageDescription": "Connect to your Mac over SSH to view and steer its agents.",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsMultipleScenes": "NO",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.mikemcquaid.Sanductor",
        "PRODUCT_MODULE_NAME": "SanductoriOS",
        "PRODUCT_NAME": "Sanductor",
        "PROVISIONING_PROFILE_SPECIFIER[config=Release]": "$(IOS_PROFILE_UUID)",
        "SDKROOT": "iphoneos",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_STRICT_CONCURRENCY": "complete",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1",
      },
    }, {
      "name": "SanductorApp",
      "id": "0784247C4CBD02AB7771A72A",
      "product": "id:A5FEC9402FE5EC1D2F06E2E4",
      "product-type": "application",
      "legacy-provisioning-style": "manual",
      "specialized-configurations": [
        { "name": "Debug", "file": ".build/version.xcconfig" },
        { "name": "Release", "file": ".build/version.xcconfig" },
      ],
      "build-phases": [
        "compile-sources",
        "resources",
        "frameworks",
      ],
      "package-product-members": [
        {
          "product-name": "DashboardFeature",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "PRFeature",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "ReviewFeature",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "SanductorData",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "SanductorInterface",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "SessionFeature",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "TerminalUI",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGN_ENTITLEMENTS": "App/Sanductor.entitlements",
        "CODE_SIGN_IDENTITY": "-",
        "CODE_SIGN_STYLE": "Manual",
        "COMBINE_HIDPI_IMAGES": "YES",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.developer-tools",
        "INFOPLIST_KEY_NSDesktopFolderUsageDescription": "Sanductor reads a directory you listed yourself. Deny this and remove the directory from its repository's menu if you would rather it never looked.",
        "INFOPLIST_KEY_NSDocumentsFolderUsageDescription": "Sanductor reads a directory you listed yourself. Deny this and remove the directory from its repository's menu if you would rather it never looked.",
        "INFOPLIST_KEY_NSDownloadsFolderUsageDescription": "Sanductor reads a directory you listed yourself. Deny this and remove the directory from its repository's menu if you would rather it never looked.",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "© 2026 Mike McQuaid.",
        "INFOPLIST_KEY_NSNetworkVolumesUsageDescription": "Sanductor reads a directory you listed yourself, or a repository on a share. Deny this and keep your work on a local disk if you would rather it never looked.",
        "INFOPLIST_KEY_NSRemovableVolumesUsageDescription": "Sanductor reads a directory you listed yourself, or a repository on a removable disk. Deny this and keep your work on the internal disk if you would rather it never looked.",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "26.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.mikemcquaid.Sanductor",
        "PRODUCT_NAME": "Sanductor",
        "SDKROOT": "macosx",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_STRICT_CONCURRENCY": "complete",
        "SWIFT_VERSION": "6.0",
      },
    }, {
      "name": "SanductorIntentTests",
      "id": "C278B11EE16BBEBB876A543D",
      "product": "Products/SanductorIntentTests.xctest",
      "product-type": "bundle.ui-testing",
      "legacy-provisioning-style": "manual",
      "test-host-target": "SanductorApp",
      "dependencies": [
        "SanductorApp",
      ],
      "build-phases": [
        "compile-sources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGN_IDENTITY": "-",
        "CODE_SIGN_STYLE": "Manual",
        "COMBINE_HIDPI_IMAGES": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@loader_path/Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "27.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.mikemcquaid.SanductorIntentTests",
        "SDKROOT": "macosx",
        "SWIFT_STRICT_CONCURRENCY": "complete",
        "SWIFT_VERSION": "6.0",
        "TEST_TARGET_NAME": "SanductorApp",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_ANALYZER_GCD_PERFORMANCE": "YES",
    "CLANG_ANALYZER_LOCALIZABILITY_EMPTY_CONTEXT": "YES",
    "CLANG_ANALYZER_LOCALIZABILITY_NONLOCALIZED": "YES",
    "CLANG_ANALYZER_NONNULL": "YES",
    "CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION": "YES_AGGRESSIVE",
    "CLANG_ANALYZER_OSOBJECT_C_STYLE_CAST": "YES",
    "CLANG_ANALYZER_OTHER_FLAGS": "$(inherited) -Xclang -analyzer-werror",
    "CLANG_ANALYZER_SECURITY_BUFFER_OVERFLOW_EXPERIMENTAL": "YES",
    "CLANG_ANALYZER_SECURITY_FLOATLOOPCOUNTER": "YES",
    "CLANG_ANALYZER_SECURITY_INSECUREAPI_RAND": "YES",
    "CLANG_ANALYZER_SECURITY_INSECUREAPI_STRCPY": "YES",
    "CLANG_CXX_LANGUAGE_STANDARD": "gnu++14",
    "CLANG_CXX_LIBRARY": "libc++",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CLANG_ENABLE_OBJC_WEAK": "YES",
    "CLANG_STATIC_ANALYZER_MODE": "deep",
    "CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING": "YES",
    "CLANG_WARN_BOOL_CONVERSION": "YES",
    "CLANG_WARN_COMMA": "YES",
    "CLANG_WARN_CONSTANT_CONVERSION": "YES",
    "CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS": "YES",
    "CLANG_WARN_DIRECT_OBJC_ISA_USAGE": "YES_ERROR",
    "CLANG_WARN_DOCUMENTATION_COMMENTS": "YES",
    "CLANG_WARN_EMPTY_BODY": "YES",
    "CLANG_WARN_ENUM_CONVERSION": "YES",
    "CLANG_WARN_INFINITE_RECURSION": "YES",
    "CLANG_WARN_INT_CONVERSION": "YES",
    "CLANG_WARN_NON_LITERAL_NULL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF": "YES",
    "CLANG_WARN_OBJC_LITERAL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_ROOT_CLASS": "YES_ERROR",
    "CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER": "YES",
    "CLANG_WARN_RANGE_LOOP_ANALYSIS": "YES",
    "CLANG_WARN_STRICT_PROTOTYPES": "YES",
    "CLANG_WARN_SUSPICIOUS_MOVE": "YES",
    "CLANG_WARN_UNGUARDED_AVAILABILITY": "YES_AGGRESSIVE",
    "CLANG_WARN_UNREACHABLE_CODE": "YES",
    "CLANG_WARN__DUPLICATE_METHOD_MATCH": "YES",
    "COPY_PHASE_STRIP": "NO",
    "DEAD_CODE_STRIPPING": "YES",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "GCC_C_LANGUAGE_STANDARD": "gnu11",
    "GCC_DYNAMIC_NO_PIC[config=Debug]": "NO",
    "GCC_NO_COMMON_BLOCKS": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
      "$(inherited)",
      "DEBUG=1",
    ],
    "GCC_TREAT_WARNINGS_AS_ERRORS": "YES",
    "GCC_WARN_64_TO_32_BIT_CONVERSION": "YES",
    "GCC_WARN_ABOUT_RETURN_TYPE": "YES_ERROR",
    "GCC_WARN_INHIBIT_ALL_WARNINGS": "NO",
    "GCC_WARN_UNDECLARED_SELECTOR": "YES",
    "GCC_WARN_UNINITIALIZED_AUTOS": "YES_AGGRESSIVE",
    "GCC_WARN_UNUSED_FUNCTION": "YES",
    "GCC_WARN_UNUSED_VARIABLE": "YES",
    "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
    "MACOSX_DEPLOYMENT_TARGET": "26.0",
    "MTL_ENABLE_DEBUG_INFO[config=Debug]": "INCLUDE_SOURCE",
    "MTL_ENABLE_DEBUG_INFO[config=Release]": "NO",
    "MTL_FAST_MATH": "YES",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "OTHER_CFLAGS": [
      "$(inherited)",
      "-Weverything",
    ],
    "OTHER_CPLUSPLUSFLAGS": [
      "$(inherited)",
      "-Weverything",
    ],
    "OTHER_LDFLAGS": [
      "$(inherited)",
      "-Wl,-fatal_warnings",
    ],
    "OTHER_SWIFT_FLAGS": "$(inherited) -warn-implicit-overrides",
    "PRODUCT_NAME": "$(TARGET_NAME)",
    "RUN_CLANG_STATIC_ANALYZER": "YES",
    "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
    "SUPPRESS_WARNINGS": "NO",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
    "SWIFT_STRICT_MEMORY_SAFETY": "YES",
    "SWIFT_SUPPRESS_WARNINGS": "NO",
    "SWIFT_TREAT_WARNINGS_AS_ERRORS": "YES",
    "SWIFT_VERSION": "5.0",
  },
  "last-upgrade": "27.2",
}
