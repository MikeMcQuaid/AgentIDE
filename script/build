#!/bin/bash
# Build Sanductor.app, update the repository-root symlink and print its path.
set -euo pipefail

cd "$(dirname "$0")/.."

# See `script/version`, which decides both of these and writes the
# xcconfig the project includes, so a build started in Xcode
# is versioned the same way this one is.
{
  read -r version
  read -r BUILD_NUMBER
} < <(script/version)
script/version --xcconfig .build/version.xcconfig

# Capped parallelism inside the sandbox: full-width builds have
# triggered resource kills that tore down the whole sandbox user,
# taking the production herdr server and its agents with it.
JOBS="$(sysctl -n hw.ncpu)"
[[ -n "${SV_SESSION_ID:-}" ]] && JOBS=6
configuration="${XCODE_CONFIGURATION:-Release}"

ARGS=(
  -project Sanductor.xcodeproj
  -scheme SanductorApp
  -configuration "${configuration}"
  -destination "${XCODE_DESTINATION:-platform=macOS,arch=arm64}"
  -derivedDataPath .DerivedData
  -clonedSourcePackagesDirPath .build
  -onlyUsePackageVersionsFromResolvedFile
  -jobs "${JOBS}"
  ARCHS=arm64
)

ARGS+=("CURRENT_PROJECT_VERSION=${BUILD_NUMBER}" "MARKETING_VERSION=${version}")
ACTIONS=(build)

# Inside the sandbox this is the whole build: Xcode runs SwiftTerm's
# build tool plugin under `sandbox-exec`, which cannot nest, so
# `xcodebuild` cannot get past it here however its flags are set.
# `swift build` runs the same plugin unsandboxed and compiles every
# target, `App` included, through the `SanductorAppSources` target
# that exists for exactly this. What it cannot make is the bundle:
# the app itself is built on the host and by CI. Nothing xcodebuild
# needs is prepared first: the sandbox user's preferences daemon has
# been unreachable after a reboot, and a `defaults` call that only
# the host's build reads must not be what stops this one.
if [[ -n "${SV_SESSION_ID:-}" ]]; then
  export SWIFTPM_DISABLE_SANDBOX=1
  export SWIFT_BUILD_USE_SANDBOX=0
  echo "sandboxed: building every target with swift build" >&2
  echo "the app bundle itself is the host's and CI's to build" >&2
  # The same cap as the sandbox's tests: this path never reached the
  # job cap above, so it built at full width, which is what the
  # comment beside that cap warns about. Niced rather than put in the
  # background band: the band throttles file I/O too, which took a
  # full rebuild from about a minute to twelve.
  exec nice -n 10 swift build --disable-sandbox --force-resolved-versions --disable-get-task-allow-entitlement --jobs "${JOBS}" \
    --configuration "$(tr '[:upper:]' '[:lower:]' <<<"${configuration}")"
fi

script/package-pins

# Package plugins are trusted everywhere: SwiftTerm 1.19 ships a
# build-tool plugin, and a non-interactive xcodebuild fails on an
# untrusted one where the Xcode app would have asked. The prompt is
# the app's alone, so the flag is the only answer from a script.
ARGS+=(-skipPackagePluginValidation)

xcodebuild "${ARGS[@]}" "${ACTIONS[@]}"

app=".DerivedData/Build/Products/${configuration}/Sanductor.app"
codesign --verify --deep --strict "${app}"
ln -sfn "${app}" Sanductor.app
# Icon caches key on the bundle's modification time; bump it so the
# Dock and Finder notice icon changes.
touch "${app}"
echo "${app}"
