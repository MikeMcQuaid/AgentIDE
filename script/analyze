#!/bin/bash
# Static analysis: unused declarations and imports via SwiftLint's
# analyzer, plus dead-code detection via periphery when available.
set -euo pipefail

cd "$(dirname "$0")/.."

[[ -d AgentIDE.xcodeproj ]] || script/bootstrap

log=".build/analyze-build.log"
mkdir -p .build

args=(
  -project AgentIDE.xcodeproj
  -scheme AgentIDEApp
  -destination "${XCODE_DESTINATION:-platform=macOS,arch=arm64}"
  -derivedDataPath .DerivedData
)

if [[ -n "${SV_SESSION_ID:-}" ]]; then
  export SWIFTPM_DISABLE_SANDBOX=1
  export SWIFT_BUILD_USE_SANDBOX=0
  # The literal $(inherited) is for xcodebuild, not the shell.
  # shellcheck disable=SC2016
  args+=(
    -IDEPackageSupportDisableManifestSandbox=1
    -IDEPackageSupportDisablePackageSandbox=1
    'OTHER_SWIFT_FLAGS=$(inherited) -disable-sandbox'
  )
fi

# A failed build must never be analysed: SwiftLint and periphery
# both read what the build produced, so a broken or stale build
# reports a confident "0 violations" while CI, building cleanly,
# finds real dead code. Xcode 27 beta's swift-plugin-server also
# fails to expand SwiftUI macros now and then, which looks exactly
# like a compile error, so one retry separates the flake from a
# genuine failure before giving up.
build() {
  xcodebuild "${args[@]}" clean build >"$log" 2>&1
}

if ! build; then
  echo "build failed; retrying once in case the macro plugin server flaked" >&2
  if ! build; then
    echo "analyze aborted: the build failed, so there is nothing trustworthy to analyse" >&2
    grep -E "error:" "$log" | head -20 >&2
    exit 1
  fi
fi
if [[ -n "${SV_SESSION_ID:-}" ]]; then
  # The sandbox's SourceKit misreads one import as unused; the
  # baseline swallows exactly that known false positive so real
  # findings still fail, while the host and CI stay strict with no
  # baseline at all. The template carries no absolute paths, so it
  # works for any sandbox user's checkout.
  baseline=".build/swiftlint-analyze-baseline.json"
  sed "s#__CHECKOUT__#$(pwd | sed 's#/#\\\\/#g')#g" \
    .swiftlint-analyze-sandbox-baseline.template.json >"$baseline"
  swiftlint analyze --compiler-log-path "$log" --strict --baseline "$baseline"
else
  swiftlint analyze --compiler-log-path "$log" --strict
fi

# The project is scanned through the app scheme because periphery's
# SPM mode does not find an index store under the current build
# system; the app scheme excludes the test targets, so the few
# declarations used only by tests carry `// periphery:ignore`.
if ! command -v periphery &>/dev/null; then
  echo "skipping periphery: not installed (add it via the Brewfile)" >&2
elif [[ -n "${SV_SESSION_ID:-}" ]]; then
  # periphery re-drives xcodebuild, whose package resolution cannot
  # nest inside sandbox-exec; these user defaults turn off SPM's own
  # manifest sandbox for this already sandboxed user, and the scan
  # reuses the index store the build above just wrote instead of
  # building again.
  defaults write com.apple.dt.Xcode IDEPackageSupportDisableManifestSandbox -bool YES
  defaults write com.apple.dt.Xcode IDEPackageSupportDisablePackageSandbox -bool YES
  periphery scan \
    --project AgentIDE.xcodeproj \
    --schemes AgentIDEApp \
    --skip-build \
    --index-store-path .DerivedData/Index.noindex/DataStore \
    --strict \
    --disable-update-check
else
  periphery scan \
    --project AgentIDE.xcodeproj \
    --schemes AgentIDEApp \
    --strict \
    --disable-update-check
fi
