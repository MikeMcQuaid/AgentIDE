#!/bin/bash
# Static analysis: unused declarations and imports via SwiftLint's
# analyzer, plus dead-code detection via periphery.
set -euo pipefail

cd "$(dirname "$0")/.."

[[ -d AgentIDE.xcodeproj ]] || script/bootstrap
script/version --xcconfig .build/version.xcconfig

log=".build/analyze-build.log"
ios_log=".build/analyze-ios-build.log"
mkdir -p .build

if [[ -n "${AGENTIDE_ANALYZE_BASE:-}" ]]; then
  git diff --name-only -z --no-renames --diff-filter=d "${AGENTIDE_ANALYZE_BASE}" HEAD -- '*.swift' |
    while IFS= read -r -d '' source; do
      printf '%s/%s\n' "${PWD}" "${source}"
    done >.build/analyze-changed-sources.xcfilelist
fi

args=(
  -project AgentIDE.xcodeproj
  -configuration "${XCODE_CONFIGURATION:-Debug}"
  -clonedSourcePackagesDirPath .build
  -onlyUsePackageVersionsFromResolvedFile
  ARCHS=arm64
)

if [[ -n "${SV_SESSION_ID:-}" ]]; then
  export SWIFTPM_DISABLE_SANDBOX=1
  export SWIFT_BUILD_USE_SANDBOX=0
  ios_swift_args=(--triple arm64-apple-ios26.0-simulator
    --sdk "$(xcrun --sdk iphonesimulator --show-sdk-path)")
elif command -v xcodegen &>/dev/null; then
  script/project
fi

# Package plugins are trusted everywhere, as in script/build: only
# the Xcode app can show the trust prompt a non-interactive build
# would otherwise fail on.
args+=(-skipPackagePluginValidation)
periphery_args=(
  --project AgentIDE.xcodeproj --schemes AgentIDEApp AgentIDE-iOS
  --skip-build --index-store-path .DerivedData/Index.noindex/DataStore
  .DerivedData/iOS/Index.noindex/DataStore
  -- -skipPackagePluginValidation -onlyUsePackageVersionsFromResolvedFile -clonedSourcePackagesDirPath .build
)

# A failed build must never be analysed: SwiftLint and periphery
# both read what the build produced, so a broken or stale build
# reports a confident "0 violations" while CI, building cleanly,
# finds real dead code. Xcode 27 beta's swift-plugin-server also
# fails to expand SwiftUI macros now and then, which looks exactly
# like a compile error, so one retry separates the flake from a
# genuine failure before giving up.
build() {
  : >"$ios_log"
  if [[ -n "${SV_SESSION_ID:-}" ]]; then
    # A fresh native index includes every source and no deleted declarations.
    rm -rf .build/analyze || return
    nice -n 10 swift build --disable-sandbox --force-resolved-versions --disable-get-task-allow-entitlement --jobs 6 \
      --build-system native --disable-build-manifest-caching --enable-index-store \
      --build-tests --scratch-path .build/analyze >"$log" 2>&1 || return
    # Both platforms must contribute references: a macOS-only index
    # makes every caller behind #if os(iOS) look like dead code.
    nice -n 10 swift build --disable-sandbox --force-resolved-versions --jobs 6 \
      --build-system native --enable-index-store --target AgentIDEiOSAppSources \
      --scratch-path .build/analyze "${ios_swift_args[@]}" >>"$log" 2>&1
  else
    rm -rf .DerivedData/Index.noindex .DerivedData/iOS/Index.noindex || return
    xcodebuild "${args[@]}" -scheme AgentIDEApp \
      -destination "${XCODE_DESTINATION:-platform=macOS,arch=arm64}" -derivedDataPath .DerivedData \
      clean build-for-testing CODE_SIGNING_ALLOWED=NO \
      COMPILER_INDEX_STORE_ENABLE=YES INDEX_ENABLE_DATA_STORE=YES >"$log" 2>&1 || return
    xcodebuild "${args[@]}" -scheme AgentIDE-iOS \
      -destination 'generic/platform=iOS Simulator' -derivedDataPath .DerivedData/iOS \
      clean build CODE_SIGNING_ALLOWED=NO \
      COMPILER_INDEX_STORE_ENABLE=YES INDEX_ENABLE_DATA_STORE=YES >"$ios_log" 2>&1
  fi
}

if ! build; then
  echo "build failed; retrying once in case the macro plugin server flaked" >&2
  if ! build; then
    echo "analyze aborted: the build failed, so there is nothing trustworthy to analyse" >&2
    grep -E "error:" "$log" "$ios_log" | head -20 >&2
    exit 1
  fi
fi
# Both host passes run, and the script fails at the end if either
# did: SwiftLint's analyzer trips over the beta's macro plugin server
# often enough that aborting on it kept periphery from ever running
# here, so CI found dead code this gate had silently skipped.
failed=0
if [[ -n "${SV_SESSION_ID:-}" ]]; then
  # Exporting the manifest avoids Periphery's nested package sandbox.
  swift package --disable-sandbox describe --type json >.build/analyze-package.json
  periphery_args=(
    --json-package-manifest-path .build/analyze-package.json
    --index-store-path "$(swift build --disable-sandbox --build-system native --scratch-path .build/analyze --show-bin-path)/index/store"
    "$(swift build --disable-sandbox --build-system native --scratch-path .build/analyze "${ios_swift_args[@]}" --show-bin-path)/index/store"
    --skip-build
  )
  echo "sandboxed: Periphery runs here; SwiftLint analysis still needs the host's Xcode log" >&2
else
  # SourceKit's cursor lookup enters inactive branches, even for an
  # unavailable SDK. Analyse platform-specific files with their own SDK.
  rg --files "${PWD}/App" "${PWD}/Sources" "${PWD}/Tests" -g '*.swift' -g '!**/iOS/**' >.build/analyze-mac-sources.xcfilelist
  rg --files "${PWD}/iOSApp" "${PWD}/Sources" -g '*.swift' -g '!**/macOS/**' >.build/analyze-ios-sources.xcfilelist
  analyze_imports() {
    local sources=".build/analyze-${1}-sources.xcfilelist"
    local analysis_log=".build/analyze-swiftlint-${1}.log"
    if [[ -n "${AGENTIDE_ANALYZE_BASE:-}" ]]; then
      awk 'NR == FNR { changed[$0] = 1; next } $0 in changed' \
        .build/analyze-changed-sources.xcfilelist "${sources}" >"${sources}.changed"
      mv "${sources}.changed" "${sources}"
    fi
    : >"${analysis_log}"
    if [[ ! -s "${sources}" ]]; then
      echo "No changed ${1} sources to analyse for unused imports"
      return
    fi
    SCRIPT_INPUT_FILE_LIST_COUNT=1 SCRIPT_INPUT_FILE_LIST_0="${sources}" \
      swiftlint analyze --compiler-log-path "$2" --strict --use-script-input-file-lists 2>&1 |
      tee "${analysis_log}" || failed=1
    # Changed files may belong only to the other platform's build.
    if [[ -z "${AGENTIDE_ANALYZE_BASE:-}" ]] && grep -q 'in 0 files\.$' "${analysis_log}"; then
      echo 'analyze failed: SwiftLint checked no files' >&2
      failed=1
    fi
  }
  analyze_imports mac "$log"
  analyze_imports ios "$ios_log"
fi

# On the host the project is scanned through both app schemes because periphery's
# SPM mode does not find an index store under the current build
# system; these schemes exclude the package test targets, so the few
# declarations used only by tests carry `// periphery:ignore`.
# Exclude SwiftTerm's generated plugin sources before indexing: separate
# platform builds generate conflicting copies. Keep Periphery's defaults.
if ! command -v periphery &>/dev/null; then
  echo "periphery is required: install it with script/bootstrap" >&2
  failed=1
else
  periphery scan \
    --index-exclude '**/*?.build/**/*' '**/SourcePackages/checkouts/**' '**/BuildToolPluginIntermediates/**' \
    --report-exclude '**/.DerivedData/**' \
    --retain-unused-imported-modules SwiftTerm \
    --strict \
    --disable-update-check \
    "${periphery_args[@]}" || failed=1
fi

exit "$failed"
