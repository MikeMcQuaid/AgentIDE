#!/bin/bash
# Install Brewfile dependencies (or named formulae) and prepare Xcode settings.
set -euo pipefail

cd "$(dirname "$0")/.."

if [[ $# -gt 0 ]]; then
  brew install "$@"
elif ! brew bundle check &>/dev/null; then
  brew bundle
fi

script/version --xcconfig .build/version.xcconfig
script/package-pins
