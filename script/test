#!/bin/bash
# Run the Swift package tests.
set -euo pipefail

cd "$(dirname "$0")/.."

# The tests run every process the app does, and with the performance
# log switched on they wrote thousands of scratch-repository lines
# into the real one; they log into their own scratch instead.
export AGENTIDE_PERFORMANCE_LOG_DIRECTORY="${PWD}/.test-scratch/performance"

# Stops the herdr servers a killed run left behind. Each test server
# is bound to a socket under this checkout's .test-scratch, which is
# what says it is ours; nothing else is ever signalled, least of all
# the production server the app and its agents live in. A run the
# system kills (resource pressure culls the sandbox user under load)
# never reaches its own teardown, and every orphan then holds its
# memory until the machine reboots, making the next kill likelier.
sweep_test_servers() {
  local scratch="${PWD}/.test-scratch/"
  local pid socket
  # Listed with ps rather than pgrep: pgrep does not see every
  # herdr in this sandbox, and a sweep that cannot see a server
  # cannot stop it.
  for pid in $(ps -axo pid=,args= | awk '$2 == "herdr" && $3 == "server" { print $1 }'); do
    socket="$(lsof -a -p "${pid}" -U -Fn 2>/dev/null |
      sed -n 's/^n//p' | grep 'herdr\.sock$' | head -1)"
    case "${socket}" in
      "${scratch}"*) kill "${pid}" 2>/dev/null || true ;;
    esac
  done
}

# Before as well as after: a run killed outright leaves orphans no
# trap of its own can reach.
sweep_test_servers
trap sweep_test_servers EXIT INT TERM
find .test-scratch -mindepth 1 -maxdepth 1 -mtime +0 -exec rm -rf {} + 2>/dev/null || true

if [[ -n "${SV_SESSION_ID:-}" ]]; then
  export SWIFTPM_DISABLE_SANDBOX=1
  export SWIFT_BUILD_USE_SANDBOX=0
  # Capped and niced: full-width builds inside the sandbox have
  # triggered resource kills that tore down the whole sandbox user,
  # taking the production herdr server and its agents with it. The
  # background band (`taskpolicy -b`) throttles file I/O as well as
  # CPU and made a run take minutes rather than seconds, so the cap
  # and the niceness do the work instead. Not exec'd: the sweep above
  # runs on the way out.
  nice -n 10 swift test --disable-sandbox --jobs 6
  exit
fi

swift test

# The App Intents run through the system's own runtime from a UI
# testing bundle, which only xcodebuild can build and run: host and
# CI, never the sandbox. AGENTIDE_SKIP_INTENT_TESTS=1 leaves them out.
# The framework refuses a runner signed differently from the app
# ("does not have permission to perform this"), so both sign with one
# real team, named in the environment; without one the bundle is left
# out, which is what CI has.
if [[ -z "${AGENTIDE_DEVELOPMENT_TEAM:-}" ]]; then
  echo "AGENTIDE_DEVELOPMENT_TEAM unset: skipping the App Intents tests" >&2
elif [[ -z "${AGENTIDE_SKIP_INTENT_TESTS:-}" ]] && command -v xcodegen &>/dev/null; then
  xcodegen generate --use-cache
  # Quiet, so the build's noise stays out, but a failure's reasons
  # come back out of the result bundle: xcodebuild -quiet names the
  # failing tests and nothing else.
  results="${PWD}/.test-scratch/intent-tests.xcresult"
  rm -rf "${results}"
  if ! xcodebuild test \
    -project AgentIDE.xcodeproj \
    -scheme AgentIDEApp \
    -only-testing:AgentIDEIntentTests \
    -skipPackagePluginValidation \
    -resultBundlePath "${results}" \
    CODE_SIGN_STYLE=Automatic \
    CODE_SIGN_IDENTITY="Apple Development" \
    DEVELOPMENT_TEAM="${AGENTIDE_DEVELOPMENT_TEAM}" \
    -quiet; then
    xcrun xcresulttool get test-results summary --path "${results}" 2>/dev/null |
      python3 -c '
import json, sys
summary = json.load(sys.stdin)
for failure in summary.get("testFailures", []):
    print("FAIL " + failure.get("testName", "?") + ": " + failure.get("failureText", "").strip())
' >&2 || true
    exit 1
  fi
fi
