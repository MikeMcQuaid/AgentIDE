#!/bin/bash
# Attach this terminal to the sandboxed herdr session, focusing the
# named workspace when one is given, or list the workspaces when run
# without arguments (works as the host user or inside the sandbox).
set -euo pipefail

if [[ $# -gt 1 ]]; then
  echo "Usage: ${0} [workspace]" >&2
  exit 1
fi

no_sessions() {
  echo "No agent sessions are running."
  exit 0
}

# Focuses the workspace whose label matches $1, then attaches; run
# inside the sandbox where the herdr socket lives. The id is dug out
# of the JSON listing with text tools because the sandbox guarantees
# no JSON processor.
# shellcheck disable=SC2016 # the payload expands in the shell it is
# handed to, not in this one.
ATTACH='
if [[ -n "${1:-}" ]]; then
  id="$(herdr workspace list 2>/dev/null \
    | tr "{" "\n" \
    | grep -F "\"label\":\"${1}\"" \
    | grep -o "\"workspace_id\":\"[^\"]*\"" \
    | head -1 | cut -d "\"" -f4)"
  [[ -n "${id}" ]] && herdr workspace focus "${id}" &>/dev/null
fi
exec herdr'

if [[ -n "${SV_SESSION_ID:-}" ]]; then
  # Matches HerdrClient: the installed app's named session.
  export HERDR_SESSION=agentide
  if [[ $# -eq 0 ]]; then
    herdr workspace list 2>/dev/null || no_sessions
    exit 0
  fi
  exec /bin/zsh -c "${ATTACH}" herdr "$1"
fi

RUN_IN_SANDBOX=(
  sudo --login --set-home --user="sandvault-${USER}" /usr/bin/env -i
  HOME="/Users/sandvault-${USER}"
  USER="sandvault-${USER}"
  SHELL=/bin/zsh
  TERM="${TERM:-xterm-256color}"
  # The same locale the launcher pins, so herdr draws the same box
  # characters here as in the app's terminals.
  LANG=en_US.UTF-8
  PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
  HERDR_SESSION=agentide
  /usr/bin/sandbox-exec -f "/var/sandvault/sandbox-sandvault-${USER}.sb"
)

if [[ $# -eq 0 ]]; then
  "${RUN_IN_SANDBOX[@]}" /bin/zsh -c 'exec herdr workspace list' 2>/dev/null || no_sessions
  exit 0
fi

exec "${RUN_IN_SANDBOX[@]}" /bin/zsh -c "${ATTACH}" herdr "$1"
