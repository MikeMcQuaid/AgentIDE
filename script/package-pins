#!/bin/bash
# Keep Xcode on the same dependency pins as SwiftPM.
set -euo pipefail

cd "$(dirname "$0")/.."

mkdir -p Sanductor.xcodeproj/project.xcworkspace/xcshareddata/swiftpm
resolved=Sanductor.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
cmp -s Package.resolved "${resolved}" || cp Package.resolved "${resolved}"
