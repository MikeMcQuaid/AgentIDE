#!/bin/bash
# Build AgentIDE, install a copy into /Applications and relaunch, so the app
# you run daily is never the build output the next rebuild
# overwrites in place.
set -euo pipefail

cd "$(dirname "$0")/.."

build_output="$(script/build)" || {
  build_status=$?
  printf '%s\n' "${build_output}" >&2
  exit "${build_status}"
}
app="$(tail -1 <<<"${build_output}")"
[[ -d "${app}" ]] || {
  echo "No app bundle to install; run script/install on the host." >&2
  exit 1
}

# Quitting AgentIDE also hangs up commands in its shell panes.
trap '' HUP
osascript -e 'quit app "AgentIDE"' &>/dev/null || true
rm -rf /Applications/AgentIDE.app
ditto "${app}" /Applications/AgentIDE.app
open /Applications/AgentIDE.app

echo "Installed and relaunched /Applications/AgentIDE.app."
