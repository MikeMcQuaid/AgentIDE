#!/bin/bash
# Print the app's version and build number, one per line, or write them
# as an xcconfig with --xcconfig <path>. The one place either is
# decided: `script/build` passes them to xcodebuild and the generated
# project includes the xcconfig, so a build started in Xcode is
# versioned exactly as one started from a script.
set -euo pipefail

cd "$(dirname "$0")/.."

# A release workflow creates its local version tag before building, so a
# release names itself. Every other build takes the most recent tag
# behind it and says which release it continues, told apart by the build
# number; `0.0.0` is what a repository with no tags at all gets, which is
# what the release workflow reserves it for.
version="$(git describe --tags --abbrev=0 2>/dev/null || true)"
version="${version:-0.0.0}"
if [[ ! "${version}" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
  echo "Version tag must be bare MAJOR.MINOR.PATCH: ${version}" >&2
  exit 1
fi

# The build number counts the default branch's commits, so numbers are
# comparable across feature branches.
build="$(
  git rev-list --count origin/main 2>/dev/null ||
    git rev-list --count main 2>/dev/null ||
    git rev-list --count HEAD 2>/dev/null ||
    echo 1
)"

if [[ "${1:-}" == "--xcconfig" ]]; then
  path="${2:?--xcconfig needs a path}"
  mkdir -p "$(dirname "${path}")"
  # Written only when it changes, so Xcode does not rebuild the world
  # every time a script asks for the version.
  contents="// Generated by script/version; do not edit.
MARKETING_VERSION = ${version}
CURRENT_PROJECT_VERSION = ${build}"
  if [[ ! -f "${path}" || "$(cat "${path}")" != "${contents}" ]]; then
    echo "${contents}" >"${path}"
  fi
  exit 0
fi

echo "${version}"
echo "${build}"
